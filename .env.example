# Copy this file to .env for local Docker development.
# Never commit .env; the values below are local-development defaults only.

MYSQL_DATABASE=logbook
MYSQL_USER=mfb
MYSQL_PASSWORD=mfb-local-password
MYSQL_ROOT_PASSWORD=mfb-local-root-password
MYSQL_PORT=3306
WEB_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
